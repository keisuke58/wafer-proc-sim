# Generated results (reproduce with scripts/reproduce_paper.sh)
results/*.pkl
results/*.pt
results/*.npz
results/*.jsonl
results/d360_frames/
results/demo_*.csv
results/synthetic_*.csv
results/pipeline_log.jsonl

# Keep committed paper figures; ignore ad-hoc PNG dumps
results/*.png
!paper/**/figures/*.png

# Large external datasets (download separately)
data/external/**/*
!data/external/.gitkeep
data/papers/*.pdf

# Simulation run outputs (keep example INPs only)
runs/*
!runs/examples/
runs/examples/*
!runs/examples/.gitkeep
!runs/**/*.inp

# Slides / demo build output
demos/**/*.pdf
slides_*.pdf

# Editor / OS
.DS_Store
*.swp
*.swo
.vscode/
.idea/

# Streamlit secrets
.streamlit/secrets.toml
# Compiled pybind11 C++ kernel (build with fem/build_cpp_kernel.sh)
fem/_stealth_kernel*.so
